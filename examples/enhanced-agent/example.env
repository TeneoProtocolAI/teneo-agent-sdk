# Enhanced Teneo Agent Configuration

# Required: Your Ethereum private key for authentication
PRIVATE_KEY=your_ethereum_private_key_here

# Optional: Agent configuration
AGENT_NAME=Enhanced Example Agent
AGENT_DESCRIPTION=A demonstration agent showcasing the enhanced Teneo Agent SDK capabilities
AGENT_VERSION=2.0.0
AGENT_CAPABILITIES=text_processing,data_analysis,conversation,demonstration

# Optional: Network settings
WEBSOCKET_URL=ws://localhost:8090/ws
RECONNECT_ENABLED=true
RECONNECT_DELAY=5s
MAX_RECONNECTS=10
MESSAGE_TIMEOUT=30s
PING_INTERVAL=30s
HANDSHAKE_TIMEOUT=10s

# Optional: Health monitoring
HEALTH_ENABLED=true
HEALTH_PORT=8080

# Optional: Task processing
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT=30s
TASK_BUFFER_SIZE=100

# Optional: Authentication
AUTO_REGISTER=true
AGENT_ROOM=general
AUTH_RETRY_ATTEMPTS=3

# Optional: Logging
LOG_LEVEL=info
LOG_FILE=

# Optional: Ethereum settings (if needed)
ETHEREUM_RPC=http://localhost:8545
OWNER_ADDRESS=your_ethereum_address_here
NFT_CONTRACT_ADDRESS= 